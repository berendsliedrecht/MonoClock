<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined clock face glyph: thin black strokes on white, e-ink friendly. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:pivotX="54"
        android:pivotY="54">

        <!-- face -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3.5"
            android:fillColor="#00000000"
            android:pathData="M54,54 m-22,0 a22,22 0 1 0 44,0 a22,22 0 1 0 -44,0" />

        <!-- hands pointing to ten past ten -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M54,54 L54,39 M54,54 L64,60" />
    </group>
</vector>
